 "roots": {
  "mietsakne_ism": {
   "name": "Mietsakne (īsmūža divdīgļlapji)",
   "short": "mietsakne",
   "desc": "Īsmūža divdīgļlapju nezālēm raksturīga mietsakne, vairāk vai mazāk zaraina. Balandai, zvērei, akļiem viegli izraujama; liektajam amarantam, sīkgalvītei, melnajai naktenei – stipri zaraina un dziļa."
  },
  "barksaknes_ism": {
   "name": "Bārkšsaknes (īsmūža viendīgļlapji)",
   "short": "bārkšsaknes",
   "desc": "Īsmūža viendīgļlapju (stiebrzāļu) nezālēm – plaši sazarota bārkšsakņu sistēma, kas spēcīgi saaug jau cerošanas fāzē (piem., parastā gaiļsāre)."
  },
  "barksaknes": {
   "name": "Bārkšsaknes (daudzgadīgās)",
   "short": "bārkšsaknes",
   "desc": "Daudzgadīgās bārkšsakņu nezāles veido spēcīgu bārkšsakņu sistēmu; vairojas galvenokārt ar sēklām."
  },
  "mietsakne": {
   "name": "Mietsakne (daudzgadīgās)",
   "short": "mietsakne",
   "desc": "Daudzgadīgās mietsakņu nezāles – izteikta, bieži resna mietsakne ar barības vielu rezervēm; vairojas galvenokārt ar sēklām."
  },
  "sakneni": {
   "name": "Sakneņi",
   "short": "sakneņi",
   "desc": "Sakneņi ir pazemes stumbri ar pumpuriem. Vārpatai tie ir aramkārtā (5–15 cm), māllēpei daudz dziļāk (0,8–1,0 m) vairākos stāvos."
  },
  "saknu_dzinumi": {
   "name": "Sakņu dzinumi",
   "short": "sakņu dzinumi",
   "desc": "Jauni dzinumi veidojas no pumpuriem uz saknēm, kas parasti izvietotas ļoti dziļi (izņemot tīruma mīkstpieni)."
  },
  "stigas": {
   "name": "Virszemes stīgas",
   "short": "stīgas",
   "desc": "Ložņājoši virszemes dzinumi, kas mezglos iesakņojas; veido arī spēcīgas bārkšsaknes."
  },
  "bumbuli": {
   "name": "Bumbuļi sakņu galos",
   "short": "bumbuļi",
   "desc": "Bumbuļu nezāles vairojas ar bumbuļiem, kas atrodas sakņu (pazemes dzinumu) galos."
  },
  "sipoli": {
   "name": "Sīpoli",
   "short": "sīpoli",
   "desc": "Vairojas ar sīpoliem."
  }
 },
